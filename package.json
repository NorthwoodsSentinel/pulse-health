{
  "name": "pulse-health",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "db:apply": "wrangler d1 execute pulse-health-db --remote --file=shared/schema.sql",
    "db:migrate": "wrangler d1 migrations apply pulse-health-db --remote",
    "vapid:generate": "bun shared/generate-vapid.ts",
    "verify:action-pins": "node scripts/verify-action-pins.mjs",
    "test:scripts": "node --test scripts/verify-action-pins.test.mjs && node --test scripts/dco-check.test.mjs && node --test scripts/lib/main-module.test.mjs && node --test scripts/entry-points.test.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\"",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run test:scripts && vitest run --coverage",
    "validate": "npm run verify:action-pins && npm run format:check && npm run lint && npm run typecheck && npm run test",
    "dco:check": "node scripts/dco-check.mjs",
    "local:dco": "node scripts/dco-check.mjs --base origin/main",
    "local:gate": "npm run validate && npm run local:dco"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260601.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "prettier": "3.8.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "4.1.12",
    "wrangler": "^4.151.1",
    "yaml": "^2.9.0"
  }
}
