{
  "name": "pulse-health",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wrangler": "bun scripts/wrangler.ts",
    "deploy": "bun scripts/wrangler.ts deploy",
    "dev": "bun scripts/wrangler.ts dev",
    "db:apply": "bun scripts/wrangler.ts d1 execute pulse-health-db --remote --file=shared/schema.sql",
    "db:migrate": "bun scripts/wrangler.ts d1 migrations apply pulse-health-db --remote",
    "vapid:generate": "bun shared/generate-vapid.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260601.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.151.1"
  }
}
